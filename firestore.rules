rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 只認 firebase-config.js 裡的管理員帳號。只檢查「有登入」不夠，
    // 因為任何人都能用網頁上公開的 apiKey 自己註冊一個帳號。
    // 一般同事不登入，所以只能讀取，以及在抽籤開放時各抽一次。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@shuttle-draw.example.com';
    }

    function stateData() {
      return get(/databases/$(database)/documents/config/state).data;
    }

    // 手動開放，或排定時間（openAt，毫秒）已到；
    // 有設截止時間（closeAt，毫秒，0＝不截止）時，時間到就不能再抽。
    // 都用伺服器時間判斷，改手機時間沒有用。
    function isOpen() {
      return (stateData().status == 'open'
          || (stateData().status == 'scheduled'
              && stateData().openAt is int
              && request.time.toMillis() >= stateData().openAt))
        && notPastClose();
    }

    function notPastClose() {
      return !('closeAt' in stateData())
        || !(stateData().closeAt is int)
        || stateData().closeAt <= 0
        || request.time.toMillis() < stateData().closeAt;
    }

    function rosterDoc() {
      return get(/databases/$(database)/documents/config/rosterIndex).data;
    }

    function rosterIndex() {
      return rosterDoc().m;
    }

    // 姓名必須和名單相同（n 是姓名索引，管理員儲存名單時寫入）
    function nameOk(memberId, name) {
      return 'n' in rosterDoc() && rosterDoc().n[memberId] == name;
    }

    // 車長的座位固定，不能抽籤
    function notCaptain(memberId) {
      return !exists(/databases/$(database)/documents/config/captain)
        || get(/databases/$(database)/documents/config/captain).data.memberId != memberId;
    }

    // 抽籤時間要是數字，且和伺服器時間相差不超過 1 小時
    function tsOk(ts) {
      return ts is int && ts > request.time.toMillis() - 3600000 && ts < request.time.toMillis() + 3600000;
    }

    function drawable(seat) {
      return seat in ['1-1', '1-3', '2-1', '2-3', '2-4', '2-2', '3-1', '3-3', '3-4', '3-2', '4-1', '4-3', '4-4', '4-2', '5-1', '5-3', '5-4', '5-2', '6-1', '6-3', '6-4', '6-2', '7-4', '7-2', '8-4', '8-2', '9-4', '9-2', '10-4', '10-2'];
    }

    function seatPath(seat) {
      return /databases/$(database)/documents/seats/$(seat);
    }

    function drawPath(id) {
      return /databases/$(database)/documents/draws/$(id);
    }

    function auditPath(id) {
      return /databases/$(database)/documents/audit/$(id);
    }

    // 設定：所有人可讀，只有管理員可改
    match /config/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 抽籤結果：每個名單上的人只能建立一筆，建立後只有管理員能改或刪
    match /draws/{memberId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOpen()
        && request.resource.data.keys().hasOnly(['memberId', 'name', 'seat', 'station', 'ts'])
        && request.resource.data.keys().hasAll(['memberId', 'name', 'seat', 'station', 'ts'])
        && request.resource.data.memberId == memberId
        && request.resource.data.station in ['東湖宿舍站', '其他站']
        && drawable(request.resource.data.seat)
        && memberId in rosterIndex()
        && nameOk(memberId, request.resource.data.name)
        && notCaptain(memberId)
        && tsOk(request.resource.data.ts)
        && (rosterIndex()[memberId] == '' || rosterIndex()[memberId] == request.resource.data.station)
        && existsAfter(seatPath(request.resource.data.seat))
        && getAfter(seatPath(request.resource.data.seat)).data.memberId == memberId
      );
      allow update, delete: if isAdmin();
    }

    // 公基金收支：所有人可讀，只有管理員能新增或刪除。
    // 金額是正整數（元），類型只能是收入或支出，日期是 YYYY-MM-DD。
    match /ledger/{entryId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'type', 'amount', 'item', 'ts'])
        && request.resource.data.keys().hasAll(['date', 'type', 'amount', 'item', 'ts'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.item is string
        && request.resource.data.item.size() > 0
        && request.resource.data.item.size() <= 60
        && request.resource.data.ts is int;
      // 刪除收支一定要同時留下操作紀錄 audit/ledger-del-<編號>
      allow delete: if isAdmin()
        && existsAfter(auditPath('ledger-del-' + entryId))
        && getAfter(auditPath('ledger-del-' + entryId)).data.action == 'ledger.delete';
    }

    // 操作紀錄：只有管理員能新增和讀取，任何人（包含管理員）都不能修改或刪除。
    // 時間用伺服器時間，操作者是登入帳號，都不能造假。
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'detail', 'by', 'at'])
        && request.resource.data.keys().hasAll(['action', 'detail', 'by', 'at'])
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 40
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 1000
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // 座位鎖：一個座位只能被建立一次，所以不會有兩個人抽到同一個座位
    match /seats/{seat} {
      allow read: if true;
      // 座位鎖的內容必須和同一次寫入的抽籤結果完全一致
      allow create: if isAdmin() || (
        isOpen()
        && drawable(seat)
        && request.resource.data.keys().hasOnly(['memberId', 'name', 'station', 'ts'])
        && request.resource.data.keys().hasAll(['memberId', 'name', 'station', 'ts'])
        && request.resource.data.memberId is string
        && existsAfter(drawPath(request.resource.data.memberId))
        && getAfter(drawPath(request.resource.data.memberId)).data.seat == seat
        && getAfter(drawPath(request.resource.data.memberId)).data.name == request.resource.data.name
        && getAfter(drawPath(request.resource.data.memberId)).data.station == request.resource.data.station
        && getAfter(drawPath(request.resource.data.memberId)).data.ts == request.resource.data.ts
      );
      allow update, delete: if isAdmin();
    }
  }
}
